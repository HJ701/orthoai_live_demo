# Local application services
ENVIRONMENT=development
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/medical_ai_db
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
SECRET_KEY=replace-with-a-long-random-local-secret

# Local browser/API access
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
RATE_LIMIT_STORAGE=memory
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_INFERENCE_STATUS_PER_MINUTE=180

# Local uploads; production must configure private object storage.
ENABLE_LOCAL_STORAGE_FALLBACK=true
UPLOAD_DIR=./uploads

# Research Mode v3
RESEARCH_MODE_ENABLED=true
RESEARCH_UI_VERSION=research-ui/3.0.0
RESEARCH_EVENT_SCHEMA_VERSION=research-event/1.0.0
RESEARCH_EXPORT_SCHEMA_VERSION=orthoai-research-export/3.0.0

# Development-only login assistance. Keep false outside local development.
DEV_EXPOSE_OTP=false

# Model/runtime settings are documented in docs/MODEL_INTEGRATION_V2.md.
PRELOAD_MODEL_RUNTIME=false
REQUIRE_GPU_WORKER_HEARTBEAT=true
GPU_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
GPU_WORKER_HEARTBEAT_TTL_SECONDS=45
INFERENCE_UNAVAILABLE_WORKER_GRACE_SECONDS=120
INFERENCE_QUEUED_STALE_SECONDS=1800
INFERENCE_RUNNING_STALE_SECONDS=2100
DENTAL_SEGMENTATION_ENABLED=true
DENTAL_SEGMENTATION_REQUIRED=true
