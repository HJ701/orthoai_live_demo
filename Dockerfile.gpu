FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app \
    ORTHOAI_DEVICE=cuda \
    PRELOAD_MODEL_RUNTIME=true \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-client \
    libpq-dev \
    libgl1 \
    libglib2.0-0 \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /bin/bash appuser

WORKDIR /app

COPY requirements.txt requirements-gpu.txt ./

RUN python -m pip install --upgrade pip
RUN python -m pip install -r requirements-gpu.txt

COPY . .

# Fail the image build if Git LFS supplied a pointer or the deployed segmenter
# was omitted. The COCO-only DINO initialization checkpoint is intentionally
# excluded by .dockerignore.
RUN test "$(stat -c%s model_artifacts/dental_segmentation/best.pt)" -gt 300000000

RUN mkdir -p uploads && chown -R appuser:appuser /app

USER appuser

CMD ["celery", "-A", "app.celery_app", "worker", "-Q", "gpu-inference", "--loglevel=info", "--concurrency=1"]
